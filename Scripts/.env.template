# Pulse App - 收益监控配置
# 复制此文件为 .env 并填入真实值

# ============================================================
# App Store Connect API 密钥
# 获取方式: App Store Connect → 用户和访问 → 密钥 → 生成API密钥
# https://appstoreconnect.apple.com/access/api
# ============================================================
ASC_KEY_ID=YOUR_KEY_ID
ASC_ISSUER_ID=YOUR_ISSUER_ID
ASC_PRIVATE_KEY_PATH=AuthKey_XXXX.p8

# ============================================================
# 销售报告Vendor Number
# 获取方式: App Store Connect → 付款和财务报告 → Vendor ID
# ============================================================
ASC_VENDOR_NUMBER=YOUR_VENDOR_NUMBER

# ============================================================
# 监控参数
# ============================================================
TARGET_REVENUE=500.0
CHECK_INTERVAL_MINUTES=30
PRO_PRICE_USD=4.99
